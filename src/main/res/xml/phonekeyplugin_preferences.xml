<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:keep="@xml/phonekeyplugin_preferences">

    <SwitchPreference
        android:defaultValue="false"
        android:key="@string/phonekey_preference_key_presence"
        android:summary="@string/phonekey_preference_summary_presence"
        android:title="@string/phonekey_preference_title_presence"
        app:singleLineTitle="false" />

    <SwitchPreference
        android:defaultValue="false"
        android:key="@string/phonekey_preference_key_unlock"
        android:summary="@string/phonekey_preference_summary_unlock"
        android:title="@string/phonekey_preference_title_unlock"
        app:singleLineTitle="false" />

    <SwitchPreference
        android:defaultValue="false"
        android:key="@string/phonekey_preference_key_approve"
        android:summary="@string/phonekey_preference_summary_approve"
        android:title="@string/phonekey_preference_title_approve"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:persistent="false"
        android:title="@string/phonekey_preference_category_key">

        <Preference
            android:key="@string/phonekey_preference_key_fingerprint"
            android:persistent="false"
            android:selectable="false"
            android:title="@string/phonekey_label_fingerprint"
            app:singleLineTitle="false" />

        <Preference
            android:key="@string/phonekey_preference_key_delete"
            android:persistent="false"
            android:summary="@string/phonekey_preference_summary_delete"
            android:title="@string/phonekey_preference_title_delete"
            app:singleLineTitle="false" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
