<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar because we use a Toolbar widget as ActionBar -->
    <style name="KdeConnectThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/chakra_petch</item>
        <item name="fontFamily">@font/chakra_petch</item>
        <item name="android:windowBackground">@color/des_ground</item>
        <item name="android:colorBackground">@color/des_ground</item>
        <item name="android:colorBackgroundFloating">@color/des_panel</item>
        <item name="colorBackgroundFloating">@color/des_panel</item>
        <item name="colorPrimary">@color/des_accent</item>
        <item name="colorOnPrimary">@color/des_on_accent</item>
        <item name="colorPrimaryContainer">@color/des_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/des_text</item>
        <item name="colorSecondary">@color/des_accent</item>
        <item name="colorOnSecondary">@color/des_on_accent</item>
        <item name="colorSecondaryContainer">@color/des_track</item>
        <item name="colorOnSecondaryContainer">@color/des_text</item>
        <item name="colorSurface">@color/des_panel</item>
        <item name="colorSurfaceVariant">@color/des_track</item>
        <item name="colorSurfaceContainer">@color/des_panel</item>
        <item name="colorSurfaceContainerLow">@color/des_panel</item>
        <item name="colorSurfaceContainerHigh">@color/des_track</item>
        <item name="colorSurfaceContainerHighest">@color/des_track</item>
        <item name="colorSurfaceContainerLowest">@color/des_ground</item>
        <item name="colorSurfaceBright">@color/des_track</item>
        <item name="colorSurfaceDim">@color/des_ground</item>
        <item name="colorSurfaceInverse">@color/des_text</item>
        <item name="colorOnSurfaceInverse">@color/des_panel</item>
        <item name="colorPrimaryInverse">@color/des_on_accent</item>
        <item name="colorOnSurface">@color/des_text</item>
        <item name="colorOnSurfaceVariant">@color/des_secondary</item>
        <item name="colorOutline">@color/des_outline</item>
        <item name="colorOutlineVariant">@color/des_line</item>
        <item name="colorError">@color/des_error</item>
        <item name="colorOnError">@color/des_on_error</item>
        <item name="colorErrorContainer">@color/des_error_container</item>
        <item name="colorOnErrorContainer">@color/des_on_error_container</item>
        <item name="colorTertiary">@color/des_accent</item>
        <item name="colorOnTertiary">@color/des_on_accent</item>
        <item name="colorTertiaryContainer">@color/des_accent_container</item>
        <item name="colorOnTertiaryContainer">@color/des_text</item>
        <item name="android:textColorPrimary">@color/des_text</item>
        <item name="android:textColorSecondary">@color/des_secondary</item>
        <item name="android:colorAccent">@color/des_accent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Des.Control</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Des.Surface</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Des.Surface</item>
        <item name="materialButtonStyle">@style/Des.Button</item>
        <item name="navigationViewStyle">@style/MainNavigationView</item>

        <!-- Drawable definitions and overrides -->

        <item name="materialCardViewStyle">@style/KdeConnectCardStyle</item>

        <!-- https://github.com/material-components/material-components-android/issues/2732 -->
        <item name="alertDialogTheme">@style/KdeConnectDialogStyle</item>
        <item name="materialAlertDialogTheme">@style/KdeConnectDialogStyle</item>
    </style>

    <style name="KdeConnectTheme" parent="KdeConnectThemeBase" />

    <style name="KdeConnectThemeBase.NoActionBar" parent="KdeConnectTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="KdeConnectTheme.NoActionBar" parent="KdeConnectThemeBase.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="KdeConnectTheme.Toolbar" parent="Widget.AppCompat.Toolbar">
    </style>

    <style name="KdeConnectDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackgroundFloating">@color/des_panel</item>
        <item name="colorBackgroundFloating">@color/des_panel</item>
        <item name="colorSurface">@color/des_panel</item>
        <item name="colorSurfaceContainerHigh">@color/des_panel</item>
        <item name="colorOnSurface">@color/des_text</item>
        <item name="colorOnSurfaceVariant">@color/des_secondary</item>
        <item name="colorPrimary">@color/des_accent</item>
        <item name="android:layout" tools:ignore="PrivateResource">@layout/m3_alert_dialog</item>
        <item name="dialogCornerRadius" tools:ignore="PrivateResource">@dimen/des_surface_radius</item>
    </style>

    <style name="KdeConnectCardStyle" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/des_panel</item>
        <item name="cardCornerRadius">@dimen/des_surface_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/des_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="KdeConnectCardStyle.Filled" parent="KdeConnectCardStyle"/>

    <style name="MainNavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemShapeAppearance">@style/ShapeAppearance.Des.Control</item>
    </style>

    <style name="KdeConnectButton.IconButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/des_control_radius</item>
    </style>

    <style name="KdeConnectButton.IconButton.Secondary" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/des_control_radius</item>
    </style>

    <style name="ActionModeStyle" parent="Widget.AppCompat.ActionMode">
    </style>
    <style name="Theme.Transparent" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="AboutButton">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="AboutButton.TextView">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ShapeAppearance.Des.Control" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/des_control_radius</item>
    </style>
    <style name="ShapeAppearance.Des.Surface" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/des_surface_radius</item>
    </style>
    <style name="Des.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">@dimen/des_control_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
