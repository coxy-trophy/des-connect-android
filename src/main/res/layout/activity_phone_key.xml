<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.kde.kdeconnect.plugins.phonekey.PhoneKeyActivity">

    <include layout="@layout/toolbar" android:id="@+id/toolbar_layout" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/phonekey_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <TextView
                android:id="@+id/phonekey_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                tools:text="@string/phonekey_headline_approve" />

            <com.google.android.material.card.MaterialCardView
                style="@style/KdeConnectCardStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/phonekey_desktop"
                        android:text="@string/phonekey_label_desktop"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/phonekey_desktop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="DES desktop" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/phonekey_purpose"
                        android:text="@string/phonekey_label_purpose"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/phonekey_purpose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="@string/phonekey_purpose_approve" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/phonekey_user"
                        android:text="@string/phonekey_label_user"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <!-- Signed text: shown exactly as received, in the fixed-width face. -->
                    <TextView
                        android:id="@+id/phonekey_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textDirection="ltr"
                        android:textIsSelectable="false"
                        tools:text="coxy" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/phonekey_action"
                        android:text="@string/phonekey_label_action"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/phonekey_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textIsSelectable="false"
                        tools:text="sudo apt install 'café tools' --yes" />

                    <TextView
                        android:id="@+id/phonekey_fingerprint_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/phonekey_fingerprint"
                        android:text="@string/phonekey_label_fingerprint"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/phonekey_fingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone"
                        tools:text="A7AE-9D8E-EBDE-E76C"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/phonekey_expires"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Expires in 20 seconds" />

            <!-- Stacked, so long translations cannot collide. Approving is not a tap:
                 it opens the biometric prompt. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/phonekey_approve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:filterTouchesWhenObscured="true"
                android:text="@string/phonekey_approve" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/phonekey_deny"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/phonekey_deny" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
